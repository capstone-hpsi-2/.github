{
  "agents-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "git -c alias.agents-guard=!scripts/agents-guard.sh agents-guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
